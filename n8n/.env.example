# Copie para .env (na mesma pasta) e preencha. O .env NÃO vai pro git.

# Subdomínio que vai servir o n8n. O domínio precisa estar com os
# nameservers apontando para a Cloudflare.
N8N_DOMAIN=n8n.seudominio.com.br

# Token do tunnel: Cloudflare Zero Trust > Networks > Tunnels >
# Create a tunnel > Cloudflared > Docker. Copie só a string depois de --token.
CF_TUNNEL_TOKEN=cole-o-token-aqui
