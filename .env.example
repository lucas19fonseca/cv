# Chave da Groq — https://console.groq.com/keys (começa com gsk_)
GROQ_API_KEY=

# Opcional. Vazio = o servidor descobre sozinho o melhor modelo
# disponível na conta. Rode `npm run models` para ver a lista.
GROQ_MODEL=

# Opcional. Troque para apontar a outro provedor compatível com a API da OpenAI.
GROQ_BASE_URL=https://api.groq.com/openai/v1
