# Variáveis do projeto. Copie para .env.local (dev) e configure as mesmas
# em Vercel > Settings > Environment Variables (produção).

# --- Servidor (/api/chat) — NUNCA use prefixo VITE_ aqui, senão vaza no bundle

# Webhook do n8n exposto pelo Cloudflare Tunnel. Se estiver vazio, a /api/chat
# vai direto para a Groq.
N8N_WEBHOOK_URL=
# Valor do Header Auth configurado no node Webhook do n8n.
N8N_API_KEY=
# Nome do header (padrão: x-api-key).
N8N_HEADER_NAME=x-api-key
# Quanto esperar o n8n antes de cair no fallback, em ms (padrão: 12000).
N8N_TIMEOUT_MS=12000

# Fallback quando o n8n não responde. https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Front (dev) — estes VÃO para o bundle, não coloque segredo

# Base do n8n local usada só em desenvolvimento.
VITE_N8N_BASE_URL=http://localhost:5678
# Se definida, o front chama esta URL direto em vez de /api/chat.
# Deixe vazia em produção para o chat passar pela serverless function.
VITE_N8N_WEBHOOK_URL=
